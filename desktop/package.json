{
  "name": "mesho-desktop",
  "version": "0.6.1",
  "private": true,
  "description": "Local-first agent collaboration client",
  "author": "Mesho contributors",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && vite build",
    "start": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --win --dir --config electron-builder.json",
    "package:portable": "npm run build && electron-builder --win portable --config electron-builder.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "pe-library": "0.4.1",
    "prettier": "^3.6.2",
    "resedit": "1.7.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "markdown-it": "^15.0.3"
  }
}
